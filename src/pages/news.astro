---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';
---

<BaseLayout title="News | CommunityKitchenKits" description="News, partnerships, and volunteer highlights from Community Kitchen Kits.">
  <main class="news-stage">
    <h1>News!</h1>
    <article class="news-card spectrum">
      <h2>Giving Tuesday Feature on<br /><em>Spectrum News One!</em></h2>
      <a href="https://www.youtube.com/watch?v=aqLIAuqb8QM" rel="noreferrer"><img src={withBase('/assets/images/spectrum-news.webp')} alt="Community Kitchen Kits on Spectrum News One" /></a>
    </article>
    <article class="news-card ridwell">
      <h2>An Exciting New<br />Partnership!</h2>
      <a href="https://www.ridwell.com/" rel="noreferrer"><img src={withBase('/assets/images/ridwell.webp')} alt="A Ridwell collection at a home" /></a>
      <p>Beginning in 2023 Ridwell partnered with us to help collect kitchen items for our kits.</p>
    </article>
    <article class="news-card founder">
      <h2>A Conversation With Our Founder</h2>
      <a href="https://vimeo.com/649886272" rel="noreferrer"><img src={withBase('/assets/images/founder-interview.webp')} alt="Conversation with the founder" /></a>
    </article>
    <article class="news-card collective">
      <h2>Volunteer Collective</h2>
      <a href="https://www.volunteer-collective.org/" rel="noreferrer"><img src={withBase('/assets/images/volunteer-collective.webp')} alt="Volunteers collecting kitchen items" /></a>
      <p>Together we collected, built, and distributed more than 200 kitchen kits.</p>
    </article>
    <article class="news-card spotlight">
      <h2>Volunteer Spotlight</h2>
      <img src={withBase('/assets/images/volunteer-spotlight.webp')} alt="Volunteer with donated kitchen items" />
      <p>Young volunteers and school groups can make a big difference. <a href={withBase('/contact?subject=volunteer')}>Ask how to get involved.</a></p>
    </article>
    <a class="up" href={withBase('/')} aria-label="Back to home">&#8963;</a>
  </main>
</BaseLayout>

<style>
  .news-stage { position: relative; width: min(1080px, calc(100% - 28px)); min-height: 2200px; margin: 0 auto; padding-top: 55px; color: #563515; font-family: 'Amatic SC', cursive; text-transform: uppercase; }
  h1 { margin: 0 0 35px 155px; font-size: 132px; font-weight: 700; line-height: .8; }
  .news-card { position: absolute; padding: 18px; border: 2px solid; border-radius: 40px; background: #fff7e7; text-align: center; }
  .news-card h2 { margin: 0 0 12px; font-size: 38px; font-weight: 400; line-height: 1.2; letter-spacing: .05em; }
  .news-card h2 em { color: #20bab1; font-style: italic; }
  .news-card img { width: 100%; object-fit: cover; }
  .news-card p { margin: 10px 0 0; font-size: 20px; line-height: 1.32; text-align: left; }
  .spectrum { top: 228px; left: 98px; width: 348px; border-color: #20bab1; }
  .spectrum img { height: 475px; object-fit: cover; }
  .ridwell { top: 76px; left: 507px; width: 382px; border-color: #a98bc4; color: #a98bc4; }
  .ridwell img { height: 365px; }
  .founder { top: 850px; left: 0; width: 470px; border-color: #f5ae83; }
  .collective { top: 760px; right: 0; width: 465px; border-color: #f5ae83; }
  .spotlight { top: 1410px; left: 215px; width: 420px; border-color: #20bab1; }
  .up { position: absolute; bottom: 30px; left: 50%; color: #563515; font: 30px Arial, sans-serif; text-decoration: none; }
  @media (max-width: 760px) { .news-stage { display: grid; min-height: 0; gap: 28px; padding: 35px 16px 80px; } h1 { margin: 0; font-size: 90px; } .news-card { position: static; width: 100%; } .news-card img, .spectrum img, .ridwell img { height: auto; max-height: 520px; } .up { bottom: 15px; } }
</style>
